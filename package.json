{
  "name": "cleanup",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "services/*",
      "packages/*",
      "packages/transactions/*"
    ]
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "coverage": "npm run coverage --workspaces",
    "generate": "kodgen-cli generate",
    "lint": "npm run lint --workspaces",
    "prepare": "husky install",
    "release": "npm run release --workspaces",
    "test": "npm run test --workspaces",
    "type-check": "npm run type-check --workspaces",
    "version": "npx changeset version && npm i"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@rosen-bridge/changeset-formatter": "^0.1.0",
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "@typescript-eslint/parser": "^8.33.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-check-file": "^3.2.0",
    "husky": "^8.0.1",
    "kodgen": "^0.1.0",
    "kodgen-cli": "^0.1.0",
    "kodgen-typescript": "^0.1.4",
    "lint-staged": "^13.0.3",
    "@types/node": "^20.10.6",
    "@vitest/coverage-istanbul": "^3.2.4",
    "prettier": "^3.5.3",
    "tsx": "^4.19.2",
    "typescript": "^5.0.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "overrides": {
    "@rosen-clients/rate-limited-axios": "1.1.0"
  }
}

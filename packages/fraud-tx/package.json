{
  "name": "@rosen-bridge/fraud-tx",
  "version": "0.0.0",
  "description": "Transaction builder for creating fraud boxes from trigger event boxes in the Rosen Bridge cleanup service.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosen-bridge/cleanup-service.git"
  },
  "license": "MIT",
  "author": "Rosen Team",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "coverage": "npm run test -- --coverage",
    "lint": "eslint --fix . && npm run prettify",
    "prettify": "prettier --write . --ignore-path ../../.gitignore",
    "release": "npm run build && npm publish --access public",
    "test": "NODE_OPTIONS='--import tsx' vitest",
    "type-check": "tsc --noEmit"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.52.5"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": "11.6.2"
  },
  "peerDependencies": {
    "ergo-lib-wasm-nodejs": "^0.24.1"
  },
  "dependencies": {
    "@rosen-bridge/abstract-logger": "^4.0.0",
    "@rosen-bridge/ergo-box-selection": "^2.1.0",
    "@rosen-bridge/json-bigint": "^0.1.0"
  }
}

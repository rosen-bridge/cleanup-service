{
  "name": "cleanup",
  "version": "0.0.0",
  "description": "This service monitors the Rosen Bridge for fraudulent behavior by watchers and executes slashing transactions to penalize malicious actors.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosen-bridge/cleanup-service.git"
  },
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "src/index.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "coverage": "npm run test -- --coverage",
    "lint": "eslint --fix . && npm run prettify",
    "lint:check": "eslint . && npm run prettify:check",
    "prettify": "prettier --write . --ignore-path ../../.gitignore",
    "prettify:check": "prettier --check . --ignore-path ../../.gitignore",
    "start": "tsx ./src/index.ts",
    "start:dev": "tsx watch ./src/index.ts",
    "test": "NODE_OPTIONS='--import tsx' vitest --passWithNoTests",
    "type-check": "tsc --noEmit",
    "typeorm": "cross-env NODE_OPTIONS=\"--import tsx\" typeorm",
    "typeorm:generate": "npm run typeorm migration:generate ./src/db/migrations/migration -- -p -d ./src/dataSource.ts",
    "typeorm:migrate": "npm run typeorm migration:run -- -d ./src/dataSource.ts"
  },
  "dependencies": {
    "@rosen-bridge/callback-logger": "1.0.1",
    "@rosen-bridge/extended-typeorm": "^1.0.1",
    "@rosen-bridge/winston-logger": "2.0.1",
    "config": "^3.3.7",
    "reflect-metadata": "^0.1.13",
    "sqlite3": "^5.0.8"
  },
  "devDependencies": {
    "@types/config": "^0.0.41",
    "typeorm": "^0.3.26"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": "11.6.2"
  }
}
